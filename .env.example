# Copy to .env and fill in. The server reads this via --env-file-if-exists.

# The invite passphrase friends use to add sources and render. It is the ONLY
# thing guarding every write route, so make it long — the server prints a boot
# warning under 12 chars. Generate one:  openssl rand -base64 24
# Leave empty to disable creation entirely (viewing stays public).
INVITE_KEY=

# Where the tunnel points. Prod is 8013; the dev server uses 5950.
HOST=127.0.0.1
PORT=8013

# Absolute URLs in OpenGraph tags are built from this — set it to your own
# public origin. Defaults to http://localhost:<PORT> when unset.
PUBLIC_ORIGIN=https://rhapsode.example.com

# Media + sqlite live here (gitignored). Defaults to ./data next to the repo.
#DATA_DIR=/srv/rhapsode/data

# Encoder: auto-detected at boot (h264_nvenc when the GPU answers, else
# libx264). Force one with RENDER_ENCODER=libx264 | h264_nvenc.
#RENDER_ENCODER=

# Source limits (seconds / bytes). Videos longer than FETCH_WHOLE_MAX_S are
# fetched as a FETCH_WINDOW_S window around the time the user points at.
#FETCH_WHOLE_MAX_S=900
#FETCH_WINDOW_S=900
#FETCH_ABS_MAX_S=14400
#FETCH_TIMEOUT_MS=900000
#UPLOAD_MAX_BYTES=536870912
#DISK_CAP_BYTES=21474836480
#OUT_MAX_S=180

# Per-IP rate limits (requests per window). RATE_LIMIT=0 turns the limiter off.
#RATE_LIMIT_VERIFY=10
#RATE_LIMIT_FETCH=10
#RATE_LIMIT_WRITE=30
#RATE_LIMIT_READ=120
#RATE_LIMIT_WINDOW_MS=60000

# Keep failed jobs' temp dirs for debugging.
#JOB_KEEP_FAILED=0

# yt-dlp YouTube player clients, in preference order. The default trio works
# with both yt-dlp's downloader and the ffmpeg sectioned fetch; android_vr
# (yt-dlp's own default) 403s the latter.
#YTDLP_PLAYER_CLIENTS=mweb,web_embedded,android
