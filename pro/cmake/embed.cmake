# cmake -DOUT=<header> -DLIST=<"id|spv;..."> -P embed.cmake
file(READ ${LIST} ENTRIES)
set(text "// Generated by rhap_shaders(); do not edit.\n#pragma once\n#include <cstddef>\n\nnamespace rhap::shaders {\nstruct Blob {\n  const unsigned char* data;\n  size_t size;\n};\n")
foreach(entry ${ENTRIES})
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 id)
  list(GET parts 1 spv)
  file(READ ${spv} hex HEX)
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n  " hex "${hex}")
  string(APPEND text "\ninline constexpr unsigned char ${id}_bytes[] = {\n  ${hex}\n};\ninline constexpr Blob ${id}{${id}_bytes, sizeof ${id}_bytes};\n")
endforeach()
string(APPEND text "\n}  // namespace rhap::shaders\n")
file(WRITE ${OUT} "${text}")
