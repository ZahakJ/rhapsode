# cmake -DOUT=<header> -DLIST=<file holding "id|name|spv[|msl|dxil];..."> -P tachyon_embed.cmake
# Writes the shader blobs for tachyon_shaders() as byte arrays.

function(bytes path var)
  file(READ ${path} hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR count "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," hex "${hex}")
  # break the line every 32 bytes to keep the header readable by editors
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n  " hex "${hex}")
  set(${var} "${hex}" PARENT_SCOPE)
  set(${var}_count ${count} PARENT_SCOPE)
endfunction()

file(READ ${LIST} ENTRIES)
set(text "// Generated by tachyon_shaders(); do not edit.\n#pragma once\n#include \"tachyon/gfx/shader.h\"\n\nnamespace tachyon::gfx::shaders {\n")
foreach(entry ${ENTRIES})
  string(REPLACE "|" ";" parts "${entry}")
  list(GET parts 0 id)
  list(GET parts 1 name)
  list(GET parts 2 spv)
  list(LENGTH parts np)
  bytes(${spv} data)
  string(APPEND text "\ninline constexpr unsigned char ${id}_spirv[] = {\n  ${data}\n};\n")
  set(msl "{}")
  set(dxil "{}")
  if(np GREATER 4)
    list(GET parts 3 mslpath)
    list(GET parts 4 dxilpath)
    bytes(${mslpath} m)
    bytes(${dxilpath} d)
    string(APPEND text "inline constexpr unsigned char ${id}_msl[] = {\n  ${m}\n};\n")
    string(APPEND text "inline constexpr unsigned char ${id}_dxil[] = {\n  ${d}\n};\n")
    set(msl "{${id}_msl, sizeof ${id}_msl}")
    set(dxil "{${id}_dxil, sizeof ${id}_dxil}")
  endif()
  string(APPEND text "inline constexpr ShaderBlob ${id}{\"${name}\", {${id}_spirv, sizeof ${id}_spirv}, ${msl}, ${dxil}};\n")
endforeach()
string(APPEND text "\n}  // namespace tachyon::gfx::shaders\n")
file(WRITE ${OUT} "${text}")
